# Carbon Ready — environment template
# คัดลอกเป็น .env แล้วเติมค่า (อย่า commit ไฟล์ .env)
# Phase = ขั้นที่ค่านี้เริ่มจำเป็น ตาม docs/superpowers/specs/2026-07-22-guardian-api-migration-design.md
# สำคัญ: ห้ามใส่ secret ใน key ที่ขึ้นต้นด้วย VITE_ — Vite จะฝังค่าเหล่านั้นลง bundle ฝั่ง browser

# ---- SPA (Phase 1) ----
VITE_API_BASE_URL=http://localhost:4000

# ---- Backend (Phase 1) ----
DATABASE_URL=
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_BUCKET=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=

# ---- Hedera Guardian (Phase 2) ----
# Base URL ของ Guardian instance เช่น http://localhost:3000
GUARDIAN_API_URL=
# บัญชี Standard Registry ที่ backend ใช้ login เข้า Guardian
GUARDIAN_SR_USERNAME=
GUARDIAN_SR_PASSWORD=

# ---- Hedera network (Phase 2) ----
# testnet | mainnet
HEDERA_NETWORK=testnet
# Operator account ที่จ่ายค่า transaction ให้ Guardian (ฝั่ง server เท่านั้น)
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

# ---- Policy & documents (Phase 3) ----
# Policy id ที่ import แล้วใน Guardian ซึ่ง credential ทั้งหมดจะวิ่งผ่าน
GUARDIAN_POLICY_ID=
# ทางใดทางหนึ่ง: IPFS node ของตัวเอง หรือ web3.storage token
IPFS_API_URL=
WEB3_STORAGE_TOKEN=

# ---- Trust chain reads (Phase 4) ----
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
