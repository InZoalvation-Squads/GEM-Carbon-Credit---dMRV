// Prisma schema — mirrors carbon-ready/src/types/index.ts 1:1 in snake_case.
// IDs are app-generated strings (`prefix-…`, same scheme as the SPA store);
// no autoincrement anywhere so existing seed/demo identifiers survive cutover.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums (verbatim from carbon-ready/src/types/index.ts unions)
// ============================================================

enum UserRole {
  admin
  project_owner
  esg_manager
  verifier
}

enum ProjectStatus {
  draft
  active
  suspended
  retired
}

enum ProjectLifecycle {
  unregistered
  pdd_draft
  under_validation
  registered
  rejected
}

enum EvidenceCategory {
  meter_reading
  utility_bill
  commissioning_report
  site_photo
  maintenance_report
  supporting_evidence
  verification_report
}

enum EvidenceStatus {
  active
  superseded
  archived
}

enum FileKind {
  pdf
  image
  xlsx
}

enum VerificationState {
  draft
  submitted
  under_review
  revision_required
  approved
  rejected
}

enum PddState {
  draft
  submitted
  under_validation
  revision_required
  registered
  rejected
}

enum MethodologyStatus {
  active
  deprecated
}

enum RecIssueState {
  draft
  submitted
  issued
  rejected
}

// ============================================================
// Models
// ============================================================

model Organization {
  id         String   @id
  name       String
  country    String
  created_at DateTime @default(now())

  users    User[]
  projects Project[]

  @@map("organizations")
}

model User {
  id                 String   @id
  organization_id    String
  email              String   @unique
  name               String
  role               UserRole
  password_hash            String
  refresh_token_hash       String?
  refresh_token_expires_at DateTime? // 7-day refresh validity, enforced server-side
  created_at               DateTime  @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@map("users")
}

model Project {
  id              String           @id
  organization_id String
  name            String
  location        String
  capacity_kwp    Float
  commission_date String // ISO date
  status          ProjectStatus
  lifecycle_stage ProjectLifecycle
  // Real HCS topic for this project's anchors (created lazily on first anchor).
  hcs_topic_id    String?
  // Per-project HTS credit token (name = project name), created on first mint.
  hts_token_id    String?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  organization       Organization          @relation(fields: [organization_id], references: [id])
  monitoring_records MonitoringRecord[]
  evidence_files     EvidenceFile[]
  verifications      VerificationRequest[]
  pdds               Pdd[]
  rec_issue_requests RecIssueRequest[]
  credentials        Credential[]
  iot_device_maps    IotDeviceMap[]

  @@index([organization_id])
  @@map("projects")
}

// IoT device/plant → project mapping, managed from the IoT page (replaces the
// IOT_DEVICE_MAP env pairs; env pairs still work and are merged in).
model IotDeviceMap {
  id         String   @id
  // device/plant id in the EXTERNAL IoT database (e.g. plants.id)
  device_id  String   @unique
  project_id String
  // display name snapshot from the IoT side, so the page reads well offline
  label      String?
  created_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("iot_device_maps")
}

model MonitoringRecord {
  id             String   @id
  project_id     String
  record_date    String // ISO date
  generation_kwh Float
  source         String
  uploaded_at    DateTime @default(now())
  param_key      String? // methodology monitoring_params key; null = legacy default driver
  unit           String? // frozen at upload from the methodology definition

  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id, record_date])
  @@map("monitoring_records")
}

model EmissionFactor {
  id                     String   @id
  country                String
  source                 String
  factor_kgco2e_per_kwh  Float
  effective_date         String // ISO date
  version                Int
  is_current             Boolean
  created_at             DateTime @default(now())

  // Backstop for the pair-scoped advisory lock in the factors service: even
  // if a code path ever skips the lock, two racing inserts cannot both claim
  // the same version for a country+source pair.
  @@unique([country, source, version])
  @@map("emission_factors")
}

model EvidenceFile {
  id               String           @id
  project_id       String
  parent_id        String? // previous version, if any
  category         EvidenceCategory
  file_name        String
  kind             FileKind
  file_size        Int // bytes
  version_number   Int
  status           EvidenceStatus
  description      String?
  content_hash     String
  storage_path     String? // content-addressed path under STORAGE_DIR
  uploaded_by      String
  uploaded_by_name String
  uploaded_at      DateTime         @default(now())

  project  Project        @relation(fields: [project_id], references: [id])
  parent   EvidenceFile?  @relation("EvidenceVersionChain", fields: [parent_id], references: [id])
  children EvidenceFile[] @relation("EvidenceVersionChain")

  @@index([project_id])
  @@index([parent_id])
  @@map("evidence_files")
}

model VerificationRequest {
  id                      String             @id
  project_id              String
  created_by              String
  owner_name              String
  assigned_verifier_name  String
  state                   VerificationState
  monitoring_period_start String // ISO date
  monitoring_period_end   String // ISO date
  reduction_kgco2e        Float
  factors_snapshot        String
  evidence_ids            String[]
  required_categories     EvidenceCategory[]
  submitted_at            DateTime?
  locked_at               DateTime?
  sla_target_days         Int
  rejection_reason        String?
  // Hedera Guardian readiness — populated by the anchor step
  hash_value              String?
  credential_id           String?
  anchored_at             DateTime?
  hcs_topic_id            String?
  hcs_sequence_number     Int?

  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
  @@map("verification_requests")
}

model VerificationComment {
  id              String   @id
  // Deliberately NO foreign key: the SPA reuses VerificationComment for PDD
  // review threads (verification_id = pdd.id), so this column points at
  // EITHER a verification_requests row or a pdds row. An FK to one table
  // would reject the other family; the id prefix disambiguates.
  verification_id String
  evidence_id     String? // null = package-level
  evidence_name   String?
  section_key     String? // PDD section a comment is attached to (registration)
  author_id       String
  author_name     String
  author_role     UserRole
  body            String
  reply_to        String?
  created_at      DateTime @default(now())

  @@index([verification_id])
  @@map("verification_comments")
}

model Methodology {
  id         String            @id
  code       String // 'T-VER-S-01'
  name       String
  standard   String // 'T-VER' | 'Verra' | 'CDM'
  version    String
  status     MethodologyStatus
  document   Json // the full schema-v2 JSON document (incl. schema_version)
  created_at DateTime          @default(now())

  pdds Pdd[]

  @@unique([code, version])
  @@map("methodologies")
}

model Pdd {
  id                       String    @id
  project_id               String
  methodology_id           String
  methodology_snapshot     String // code + version, frozen at submit
  state                    PddState
  section_data             Json // keyed by field.key
  disclosure_salts         Json? // hex salt per sensitive field (private side of selective disclosure)
  evidence_ids             String[]
  assigned_validator_name  String
  submitted_at             DateTime?
  validated_at             DateTime? // = registered timestamp
  content_hash             String? // frozen at register
  ipfs_cid                 String? // IPFS CID (real when a Kubo node is configured), frozen at register
  credential_id            String? // PDD Registration VC id
  // Guardian policy trail { policy_id, tracking_id, submitted_at, approved_at? } — best-effort
  guardian_ref             Json?
  rejection_reason         String?

  project     Project     @relation(fields: [project_id], references: [id])
  methodology Methodology @relation(fields: [methodology_id], references: [id])

  @@index([project_id])
  @@index([methodology_id])
  @@map("pdds")
}

// SF-04: I-REC(E) Issue Request — one row per production period claimed for a
// REC-registered project. Parallel to VerificationRequest; never mixed with it.
model RecIssueRequest {
  id                     String        @id
  project_id             String
  created_by             String
  owner_name             String
  assigned_reviewer_name String
  state                  RecIssueState
  request_type           String // 'Normal' | 'Self consumption' (SF-04 §1.1)
  period_start           String // ISO date
  period_end             String // ISO date
  // Σ MonitoringRecord.generation_kwh in period ÷ 1000, 6 dp — server-computed,
  // recomputed & frozen at submit.
  total_production_mwh   Float
  applied_mwh            Float? // SF-04 "I-REC(E) applied for"; null = total
  facility_snapshot      Json // org/facility/fuel/tech copied from the REC Pdd section_data
  receiving_org_name     String
  receiving_account_id   String
  evidence_ids           String[]
  submitted_at           DateTime?
  issued_at              DateTime?
  rejection_reason       String?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt

  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
  @@map("rec_issue_requests")
}

model Credential {
  id         String   @id
  schema_id  String
  // Denormalized from the anchored entity (verification/pdd) at insert time so
  // credential + token lists can be org-scoped with a plain join; the SPA
  // derives this from payload.subject.project_id instead.
  project_id String
  payload    Json // the full signed VC object (incl. proof)
  // Real on-chain anchor metadata { topic_id, sequence_number,
  // consensus_timestamp, explorer_url } — written by the server AFTER the
  // browser signed the VC, so it lives outside the signed payload. Null when
  // anchoring is disabled or has not succeeded yet (retry endpoint).
  anchor     Json?
  created_at DateTime @default(now())

  project Project        @relation(fields: [project_id], references: [id])
  token   GuardianToken?

  @@index([project_id])
  @@map("credentials")
}

// Tiny key-value store for singleton platform state (e.g. the HTS VCU token
// id created once on first mint). Not org-scoped — platform-level facts only.
model AppState {
  key   String @id
  value String

  @@map("app_state")
}

model GuardianToken {
  id                      String   @id
  token_id                String // Hedera token id, e.g. '0.0.480200'
  serial_number           Int
  project_id              String
  credential_id           String   @unique
  amount_tco2e            Float
  monitoring_period_start String // ISO date
  monitoring_period_end   String // ISO date
  minted_at               DateTime @default(now())
  minted_by_role          UserRole
  hcs                     Json // { topic_id, sequence_number, explorer_url }
  // Dual-standard issuance detail: { serial_start, serial_end, units,
  // erc1155: { address, id, amount, tx_hash } } — null for legacy/sim rows.
  batch                   Json?

  credential Credential @relation(fields: [credential_id], references: [id])

  @@index([project_id])
  @@map("guardian_tokens")
}

model AuditLog {
  id                  String   @id
  // Monotonic insert order — the chain's authoritative ordering. created_at
  // has only ms precision, so same-millisecond rows would otherwise tie and
  // head selection could mis-chain despite the advisory lock.
  seq                 BigInt   @unique @default(autoincrement())
  user_id             String
  user_role           UserRole?
  ip_address          String?
  action              String
  entity_type         String
  entity_id           String?
  payload             Json
  previous_value      Json?
  new_value           Json?
  row_hash            String
  prev_row_hash       String?
  hcs_topic_id        String?
  hcs_sequence_number Int?
  created_at          DateTime @default(now())

  @@index([created_at])
  @@map("audit_log")
}
