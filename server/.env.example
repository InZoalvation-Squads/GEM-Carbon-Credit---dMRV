# Copy to server/.env and fill in real values. server/.env is gitignored — never commit it.

# Postgres connection string used by Prisma.
# Note: the database name is case-sensitive (e.g. carbon_credit_dMRV).
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/carbon_credit_dMRV?sslmode=disable

# JWT signing secret (min 32 chars). Generate with: openssl rand -hex 32
# The placeholder below is intentionally too short to pass config validation,
# so the server refuses to boot until you set a real secret.
JWT_SECRET=change-me

# HTTP port the API listens on (default 4000).
PORT=4000

# Allowed CORS origin — the SPA dev server (default http://localhost:5173).
CORS_ORIGIN=http://localhost:5173

# Directory for uploaded evidence bytes, relative to server/ (default ./storage, gitignored).
STORAGE_DIR=./storage

# Optional. When set, `prisma db seed` creates the 4 demo users with this
# password. Leave unset in production — demo users are then skipped entirely.
# DEMO_SEED_PASSWORD=

# Optional. Bank of Thailand API token (apiportal.bot.or.th) — enables the
# "ดึงจาก BOT" EUR→THB button on the REC ROI page. Leave unset for manual FX.
# BOT_API_TOKEN=
