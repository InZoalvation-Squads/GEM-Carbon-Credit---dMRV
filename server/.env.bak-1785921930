# ============================================================
# IoT ingest (Postgres) — เติม 2 ตัวบน + เอา # ออก แล้ว restart server
# worker จะดึงค่าจาก DB ภายนอกเข้า monitoring อัตโนมัติตาม cron
# (สั่งดึงทันทีได้ด้วย POST /api/v1/iot/sync, ดู config ด้วย GET /api/v1/iot/status)
# ============================================================

# Postgres/Timescale: postgresql://USER:PASSWORD@HOST:5432/DBNAME
# แนะนำ: ขอ user แบบ READ-ONLY จากทีมดูแล DB นั้น
IOT_DB_URL=postgresql://postgres.knzxgwajyipxoeefhmnp:fLaM6eYunPSWcelP@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# mapping plant → โปรเจกต์ จัดการจากหน้า "IoT Mapping" ในแอปแล้ว (เก็บใน DB)
# ตัวแปรนี้เหลือไว้เป็น override แบบเก่า — ปกติไม่ต้องใช้
#IOT_DEVICE_MAP=

# ตาราง/คอลัมน์ — ตรงกับ daily_plant_efficiency ใน Supabase (ยอดผลิตรายวันต่อ plant)
IOT_DB_TABLE=daily_plant_efficiency
IOT_COL_TIMESTAMP=date                # วันที่ของยอดรายวัน
IOT_COL_DEVICE_ID=plant_id            # ใช้ plant_id เป็นรหัสอุปกรณ์
IOT_COL_VALUE=actual_yield_kwh        # ยอดผลิตจริงรายวัน
IOT_VALUE_UNIT=kWh                    # kWh | Wh | MWh (ระบบแปลงเป็น kWh ให้)
IOT_VALUE_KIND=interval               # ค่าเป็นยอดต่อวันอยู่แล้ว (ไม่ใช่เลขมิเตอร์สะสม)

# จังหวะการดึง — บันทึกเฉพาะ "วันที่จบแล้ว" (ข้ามวันนี้กันข้อมูลครึ่งวัน) และไม่เขียนทับวันที่มีข้อมูลอยู่แล้ว
IOT_POLL_CRON=0 * * * *               # ทุกชั่วโมง (รูปแบบ cron)
IOT_LOOKBACK_HOURS=96                 # ตารางเป็นรายวัน เผื่อ 4 วันกันข้อมูลเข้าช้า
IOT_TIMEZONE=Asia/Bangkok             # timezone สำหรับตัดวัน
IOT_DEDUCTION_PCT=7                   # หักตามแผน monitoring ของ อบก. (เช่น 5%) ก่อนบันทึก
