{
  "name": "carbon-ready-server",
  "version": "0.1.0",
  "description": "Carbon Ready dMRV backend (Fastify 5 + Prisma + Postgres) — Phase 1a",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@noble/hashes": "^2.1.1",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
